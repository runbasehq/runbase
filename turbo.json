{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "DATABASE_URL",
        "POSTGRES_URL",
        "POSTGRES_PRISMA_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_BETTER_AUTH_URL",
        "NEXT_PUBLIC_ROOT_DOMAIN",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "RESEND_API_KEY",
        "TRUST_PROXY_HEADERS",
        "RESEND_WELCOME_FROM_EMAIL_FRAN",
        "RESEND_WELCOME_FROM_EMAIL_JERE",
        "APP_URL",
        "RESEND_FROM_EMAIL",
        "POLAR_ENVIRONMENT",
        "POLAR_ACCESS_TOKEN",
        "POLAR_WEBHOOK_SECRET",
        "POLAR_PRODUCT_ID_GROWTH_MONTHLY",
        "POLAR_PRODUCT_ID_GROWTH_YEARLY",
        "POLAR_PRODUCT_ID_PROFESSIONAL_MONTHLY",
        "POLAR_PRODUCT_ID_PROFESSIONAL_YEARLY",
        "POLAR_PRODUCT_ID_ENTERPRISE",
        "OAUTH_DEBUG_LOGS"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
